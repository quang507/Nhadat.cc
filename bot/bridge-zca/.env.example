# Chép file này thành `.env` (cùng thư mục) rồi điền giá trị thật.
# `.env` đã nằm trong .gitignore — ĐỪNG bỏ nó ra, repo này đang PUBLIC.
#
# BRIDGE_SECRET — cổng FR-151. chat-reply và escalation-feed chỉ nhận request
# kèm header x-bridge-secret khớp với secret cùng tên trong Supabase Vault.
# Lấy giá trị ở: Supabase Dashboard → Project Settings → Vault → BRIDGE_SECRET.
# Dán nguyên văn, không thêm nháy, không thêm dấu cách — lệch một ký tự là 401.
BRIDGE_SECRET=

# Muốn TẮT cổng (bridge chạy như trước khi có FR-151): xoá secret bên Vault
#   delete from vault.secrets where name = 'BRIDGE_SECRET';
# rồi bỏ trống dòng trên. Thứ tự BẬT thì ngược lại: điền .env TRƯỚC, tạo secret
# trong Vault SAU — làm ngược là bridge chết trong khoảng giữa.
