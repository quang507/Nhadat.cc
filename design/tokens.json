{
  "$schema": "https://design-tokens.org/draft",
  "meta": {
    "project": "nhadat.cc",
    "source": "docs/06-ui-design.md §6.2–6.4",
    "note": "Kế thừa bố cục theme Veedoo (cam nhấn + navy đậm), KHÔNG dùng asset của theme — NFR-15."
  },
  "color": {
    "brand": {
      "600": { "value": "#E2571E", "desc": "CTA chính, giá tiền, badge hot" },
      "500": { "value": "#F2691F", "desc": "Hover CTA" },
      "50":  { "value": "#FFF3EC", "desc": "Nền khối nhấn nhẹ" }
    },
    "ink": {
      "900": { "value": "#0E1B33", "desc": "Nền footer/header tối, chữ tiêu đề" },
      "700": { "value": "#243651", "desc": "Chữ thân bài" },
      "400": { "value": "#6B7C93", "desc": "Chữ phụ, nhãn" }
    },
    "line":    { "value": "#E3E8EF", "desc": "Viền, đường chia" },
    "surface": { "value": "#FFFFFF", "desc": "Nền card" },
    "canvas":  { "value": "#F6F8FB", "desc": "Nền trang" },
    "zalo":    { "value": "#0068FF", "desc": "CHỈ dùng cho nút/biểu tượng Zalo — không dùng cho gì khác" },
    "state": {
      "ok":     { "value": "#12805C", "desc": "Còn rao, đã xác minh" },
      "warn":   { "value": "#B45309", "desc": "Chờ xác minh, quá SLA" },
      "danger": { "value": "#B42318", "desc": "Đã bán, lỗi, phản ứng tiêu cực" }
    },
    "tint": {
      "navy-600": { "value": "#33445E" },
      "navy-300": { "value": "#B8C4D6" },
      "navy-200": { "value": "#DCE4EF" },
      "navy-400": { "value": "#8FA0B8" },
      "ok-bg":     { "value": "#E9F5F0" },
      "warn-bg":   { "value": "#FBF1E4" },
      "danger-bg": { "value": "#FAECEB" },
      "check":     { "value": "#4ADE80", "desc": "Dấu tick trên nền navy" }
    }
  },
  "font": {
    "display": { "value": "Be Vietnam Pro", "fallback": "sans-serif", "desc": "Phủ đủ dấu tiếng Việt, ổn định với dấu chồng" },
    "body":    { "value": "Inter", "fallback": "system-ui, sans-serif" },
    "mono":    { "value": "JetBrains Mono", "fallback": "monospace", "desc": "Mã BĐS #35148" }
  },
  "type": {
    "h1":    { "font": "display", "size": { "mobile": 28, "desktop": 40 }, "weight": 700 },
    "h2":    { "font": "display", "size": { "mobile": 22, "desktop": 30 }, "weight": 700 },
    "h3":    { "font": "display", "size": { "mobile": 17, "desktop": 19 }, "weight": 600 },
    "body":  { "font": "body", "size": 16, "lineHeight": 1.6, "weight": 400 },
    "label": { "font": "body", "size": 13, "weight": 500 },
    "price": { "font": "display", "size": { "mobile": 20, "desktop": 24 }, "weight": 700, "color": "brand.600" },
    "code":  { "font": "mono", "size": 14, "weight": 500 }
  },
  "space": { "scale": [4, 8, 12, 16, 24, 32, 48, 64] },
  "radius": { "card": 12, "button": 10, "image": 8, "chip": 999 },
  "shadow": {
    "1": { "value": "0 1px 2px rgba(14,27,51,0.06)", "desc": "Card" },
    "2": { "value": "0 8px 24px rgba(14,27,51,0.10)", "desc": "Hộp mời kết nối, modal" }
  },
  "layout": { "maxWidth": 1200, "gridColumns": 12, "gutter": 24, "mobileFirst": 375 },
  "icon": { "grid": 24, "strokeWidth": 2, "style": "inline SVG, stroke-based — không dùng emoji" },
  "a11y": { "textContrast": 4.5, "minTouchTarget": 44, "focusRing": "2px solid #0068FF, offset 2px" }
}
